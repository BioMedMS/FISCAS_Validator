        "![Registration Error](./output/Registration_error_plot.svg){#fig-registartion_error_plot}\n",
        "\n",
        "![Registration Overlay](./output/registration_overlay.svg){#fig-registration_overlay}\n",
        "\n",
        ":::\n"
      ],
      "id": "75c9f61f"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "df = pd.DataFrame(list(registration_metrics.items()), columns=['Key', 'Value'])\n",
        "df['Value'] = df['Value'].apply(convert_to_float_and_round)\n",
        "html_table = df.to_html(index=False)\n",
        "display(HTML(html_table))"
      ],
      "id": "04c544ae",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
