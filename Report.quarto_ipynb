    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "df = pd.DataFrame(list(segmentation_metrics.items()), columns=['Key', 'Value'])\n",
        "df['Value'] = df['Value'].apply(convert_to_float_and_round, decimal=3)\n",
        "html_table = df.to_html(index=False)\n",
        "display(HTML(html_table))"
