      "source": [
        "---\n",
        " title: Validator Report\n",
        " echo: False\n",
        " toc: False\n",
        "\n",
        " format:\n",
        "  pdf: default\n",
        "---\n",
        "\n",
        "# Registration Report"
      ],
      "id": "04c60092"
    },
    {
      "cell_type": "code",
      "metadata": {
        "tags": [
          "parameters"
        ]
      },
      "source": [
        "path_sample_cells=\"D:/Jan/fiscas-validationKit/Cell_images/microscopy/HuTu80/\"\n",
        "output=\"D:/Jan/fiscas-validationKit/output/\"\n",
        "allow_multiplets=True\n",
        "use_perfect_registration=False\n",
        "use_perfect_segmentation=True\n",
        "teaching_imprecision=10\n",
        "canvas_size=1500\n",
        "mic_spacing=0.325\n",
        "ms_spacing=5\n",
        "cell_density=0.3\n",
        "max_cell_placement_iterations=1000\n",
        "rotation=10\n",
        "scale=1.00\n",
        "mass_list=[577.5, 760.68]\n",
        "diffusion=5\n",
        "noise_loc=0.0\n",
        "noise_scale=0.0\n",
        "seed=42\n",
        "plot=True\n",
        "save_img=True\n",
        "remove_ambiguous=True\n",
        "cell_diameter=120\n",
        "texture=None\n",
        "texture_path=\"./textures/noise_150x150.jpg\"\n",
        "texture_epsilon=0.1\n",
        "\n",
        "def convert_to_float_and_round(value, decimal=4):\n",
        "    if isinstance(value, (list, tuple)):\n",
        "        return [convert_to_float_and_round(item) for item in value]\n",
        "    elif isinstance(value, np.ndarray):\n",
        "        return np.array([convert_to_float_and_round(item) for item in value])\n",
        "    else:\n",
        "        return round(float(value), decimal)"
      ],
      "id": "fbf449e2",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| output: False\n",
        "from FISCAS_Validator import Validator\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from IPython.display import HTML, display, SVG\n",
        "\n",
        "A = Validator(path_sample_cells=path_sample_cells,\n",
        "output=output,\n",
        "allow_multiplets=allow_multiplets,\n",
        "use_perfect_registration=use_perfect_registration,\n",
        "use_perfect_segmentation=use_perfect_segmentation,\n",
        "teaching_imprecision=teaching_imprecision,\n",
        "canvas_size=canvas_size,\n",
        "mic_spacing=mic_spacing,\n",
        "ms_spacing=ms_spacing,\n",
        "cell_density=cell_density,\n",
        "max_cell_placement_iterations=max_cell_placement_iterations,\n",
        "rotation=rotation,\n",
        "scale=scale,\n",
        "mass_list=mass_list,\n",
        "diffusion=diffusion,\n",
        "noise_loc=noise_loc,\n",
        "noise_scale=noise_scale,\n",
        "seed=seed,\n",
        "plot=plot,\n",
        "save_img=save_img,\n",
        "remove_ambiguous=remove_ambiguous,\n",
        "cell_diameter=cell_diameter,\n",
        "texture=texture,\n",
        "texture_path=texture_path)\n",
        "canvas_metrics, registration_metrics, segmentation_metrics, spectra_metrics = A.main()"
      ],
      "id": "d338a2c9",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Settings"
      ],
      "id": "f04be9c8"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "settings = A.return_settings()\n",
        "html_table = pd.DataFrame(list(settings.items()), columns=['Key', 'Value']).to_html(index=False)\n",
        "display(HTML(html_table))"
      ],
      "id": "2e1b31bf",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Generated Canvas\n",
        "\n",
        "::: {layout=\"[[0.9,-0.1,0.9], [0.9,-0.1,0.9]]\"}\n",
        "\n",
